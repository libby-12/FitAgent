<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitAgent.Views.BrandHeader"
             FlowDirection="LeftToRight">
    <!-- Reusable application name and logo for authentication screens. -->
    <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
        <Border WidthRequest="72" HeightRequest="72" Padding="0"
                Stroke="{StaticResource BrandLilac}" StrokeThickness="1"
                >
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Border.Clip>
                <RoundRectangleGeometry CornerRadius="20" Rect="0,0,72,72" />
            </Border.Clip>
            <Image Source="fitagent_logo.jpeg" Aspect="AspectFit" />
        </Border>
        <VerticalStackLayout Spacing="8" VerticalOptions="Center">
            <Label Text="FitAgent" FontFamily="OpenSansSemibold"
                   FontSize="34" TextColor="{StaticResource BrandText}"
                   CharacterSpacing="-1" />
            <BoxView Color="{StaticResource BrandPurple}" HeightRequest="4"
                     WidthRequest="48" CornerRadius="2" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </HorizontalStackLayout>
</ContentView>