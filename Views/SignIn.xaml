<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SignInAssignment.Views.SignIn"
             Title="">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="כניסה" 
               FontSize="32" 
               HorizontalOptions="Center" 
               FontAttributes="Bold" 
               TextColor="Black"/>

        <Entry Placeholder="Email"
               Text="{Binding UserName}"
               Keyboard="Email" 
               ClearButtonVisibility="WhileEditing"/>

        <Grid ColumnDefinitions="*, Auto">
            <Entry Grid.Column="0"
                   Placeholder="סיסמה"
                   Text="{Binding UserPassword}"
                   IsPassword="{Binding EntryAsPassword}" />

            <Button Grid.Column="1"
                    Text="{Binding PasswordIconCode}"
                    Command="{Binding TogglePasswordCommand}"
                    BackgroundColor="Transparent"
                    TextColor="Black"
                    FontSize="24"
                    FontFamily="MaterialIcons" />
        </Grid>

        <Button Text="SignIn"
                Command="{Binding SignInCommand}"
                TextColor="White"
                CornerRadius="8"
                HeightRequest="50"
                FontSize="18"
                Margin="0, 10, 0, 0">
            <Button.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="BackgroundColor" Value="LightGray" />
                </Trigger>

                <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                    <Setter Property="BackgroundColor" Value="#2196F3" />
                </Trigger>
            </Button.Triggers>
        </Button>

        <Label Text="{Binding LoginMessage}"
               TextColor="{Binding SignInMessageColor}"
               IsVisible="{Binding SignInMessageVisible}"
               HorizontalOptions="Center"
               FontSize="18"
               FontAttributes="Bold" />

    </VerticalStackLayout>
</ContentPage>