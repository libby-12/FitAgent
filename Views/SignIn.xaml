<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:FitAgent.ViewModels"
    x:DataType="viewModels:SignInViewModel"
    x:Class="FitAgent.Views.SignIn"
    Shell.NavBarIsVisible="False"
    Title=""
    xmlns:views="clr-namespace:FitAgent.Views"
    FlowDirection="LeftToRight"
    Background="{StaticResource BrandPageBackground}">
    <ScrollView>
        <VerticalStackLayout
            Padding="24,36,24,32"
            Spacing="28"
            MaximumWidthRequest="460"
            HorizontalOptions="Fill"
            VerticalOptions="Center">
            <!-- Shared brand header and styled form inside a scrollable layout. -->
            <views:BrandHeader
                xmlns:views="clr-namespace:FitAgent.Views" />
            <Border
                Style="{StaticResource AuthCard}">
                <VerticalStackLayout
                    Padding="0"
                    Spacing="14">
                    <Label
                        Text="Sign In"
                        Style="{StaticResource AuthHeading}" />
                    <Border
                        Style="{StaticResource AuthField}">
                        <Entry
                            Placeholder="Email"
                            Text="{Binding UserName}"
                            Keyboard="Email"
                            ClearButtonVisibility="WhileEditing"
                            Style="{StaticResource AuthEntry}" />
                    </Border>
                    <Border
                        Style="{StaticResource AuthField}">
                        <Grid
                            ColumnDefinitions="*, Auto">
                            <Entry
                                Grid.Column="0"
                                Placeholder="Password"
                                Text="{Binding UserPassword}"
                                IsPassword="{Binding EntryAsPassword}"
                                Style="{StaticResource AuthEntry}" />
                            <Button
                                Grid.Column="1"
                                Text="{Binding PasswordIconCode}"
                                Command="{Binding TogglePasswordCommand}"
                                Style="{StaticResource AuthPasswordToggle}" />
                        </Grid>
                    </Border>
                    <Button
                        Text="Sign In"
                        Command="{Binding SignInCommand}"
                        Style="{StaticResource AuthButton}" />
                    <FlexLayout
                        HorizontalOptions="Center"
                        Margin="0,12,0,0"
                        Wrap="Wrap"
                        JustifyContent="Center"
                        AlignItems="Center">
                        <Label
                            Text="Don't have an account?"
                            TextColor="{StaticResource BrandMutedText}"
                            VerticalOptions="Center"
                            FontSize="13"
                            Margin="3,2" />
                        <Label
                            Text="Sign up"
                            TextColor="{StaticResource BrandLilac}"
                            FontAttributes="Bold"
                            VerticalOptions="Center"
                            FontSize="13"
                            Margin="3,2">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding NavigateToSignUpCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </FlexLayout>
                    <Label
                        Text="{Binding LoginMessage}"
                        TextColor="{Binding SignInMessageColor}"
                        IsVisible="{Binding SignInMessageVisible}"
                        HorizontalOptions="Center"
                        FontSize="14"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>