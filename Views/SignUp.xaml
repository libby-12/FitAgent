<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:FitAgent.Behaviors"
    xmlns:viewModels="clr-namespace:FitAgent.ViewModels"
    x:DataType="viewModels:SignUpViewModel"
    x:Class="FitAgent.Views.SignUp"
    Shell.NavBarIsVisible="False"
    Title=""
    xmlns:views="clr-namespace:FitAgent.Views"
    FlowDirection="LeftToRight"
    Background="{StaticResource BrandPageBackground}"
    xmlns:helper="clr-namespace:FitAgent.Helper">
    <ScrollView>
        <VerticalStackLayout
            Padding="24,36,24,32"
            Spacing="28"
            MaximumWidthRequest="460"
            HorizontalOptions="Fill"
            VerticalOptions="Center">
            <!-- Shared brand header and styled form inside a scrollable layout. -->
            <views:BrandHeader
                xmlns:views="clr-namespace:FitAgent.Views" />
            <Border
                Style="{StaticResource AuthCard}">
                <VerticalStackLayout
                    Padding="0"
                    Spacing="14">
                    <Label
                        Text="Create Account"
                        Style="{StaticResource AuthHeading}" />
                    <Border
                        Style="{StaticResource AuthField}">
                        <Entry
                            Placeholder="First Name"
                            Text="{Binding FirstName}"
                            Style="{StaticResource AuthEntry}" />
                    </Border>
                    <Border
                        Style="{StaticResource AuthField}">
                        <Entry
                            Placeholder="Last Name"
                            Text="{Binding LastName}"
                            Style="{StaticResource AuthEntry}" />
                    </Border>
                    <Border
                        Style="{StaticResource AuthField}">
                        <Entry
                            Placeholder="Email"
                            Text="{Binding UserName}"
                            Keyboard="Email"
                            Style="{StaticResource AuthEntry}">
                            <Entry.Behaviors>
                                <behaviors:TrimmedEmailValidationBehavior
                                    x:Name="EmailValidator"
                                    Flags="ValidateOnValueChanged" />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>
                    <Label
                        Text="{x:Static helper:AppMessages.InvalidEmail}"
                        IsVisible="{Binding ShowEmailError}"
                        TextColor="#FFB4AB"
                        FontSize="12"
                        Margin="4,-8,0,0" />
                    <Border
                        Style="{StaticResource AuthField}">
                        <Grid
                            ColumnDefinitions="*, Auto">
                            <Entry
                                Grid.Column="0"
                                Placeholder="Password"
                                Text="{Binding UserPassword}"
                                IsPassword="{Binding EntryAsPassword}"
                                Style="{StaticResource AuthEntry}" />
                            <Button
                                Grid.Column="1"
                                Text="{Binding PasswordIconCode}"
                                Command="{Binding TogglePasswordCommand}"
                                Style="{StaticResource AuthPasswordToggle}"
                                SemanticProperties.Description="{Binding PasswordToggleDescription}" />
                        </Grid>
                    </Border>
                    <Label
                        Text="{x:Static helper:AppMessages.PasswordGuidance}"
                        TextColor="{StaticResource BrandMutedText}"
                        FontSize="12"
                        Margin="4,-8,0,0" />
                    <Border
                        Style="{StaticResource AuthField}">
                        <Entry
                            Placeholder="Phone number"
                            Text="{Binding Phone}"
                            Keyboard="Telephone"
                            Style="{StaticResource AuthEntry}" />
                    </Border>
                    <Label
                        Text="{x:Static helper:AppMessages.PhoneGuidance}"
                        TextColor="{StaticResource BrandMutedText}"
                        FontSize="12"
                        Margin="4,-8,0,0" />
                    <Button
                        Text="Sign Up"
                        Command="{Binding SignUpCommand}"
                        Style="{StaticResource AuthButton}" />
                    <FlexLayout
                        HorizontalOptions="Center"
                        Margin="0,12,0,0"
                        Wrap="Wrap"
                        JustifyContent="Center"
                        AlignItems="Center">
                        <Label
                            Text="Already have an account?"
                            TextColor="{StaticResource BrandMutedText}"
                            VerticalOptions="Center"
                            FontSize="13"
                            Margin="3,2" />
                        <Label
                            Text="Sign in"
                            TextColor="{StaticResource BrandLilac}"
                            FontAttributes="Bold"
                            VerticalOptions="Center"
                            FontSize="13"
                            Margin="3,2">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding NavigateToSignInCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </FlexLayout>
                    <Label
                        Text="{Binding SignUpMessage}"
                        TextColor="{Binding SignUpMessageColor}"
                        IsVisible="{Binding SignUpMessageVisible}"
                        HorizontalOptions="Center"
                        FontSize="14"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>