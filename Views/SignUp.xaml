<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="FitAgent.Views.SignUp"
             Shell.NavBarIsVisible="False"
             Title="">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0f0c29" Offset="0.0" />
            <GradientStop Color="#302b63" Offset="0.5" />
            <GradientStop Color="#24243e" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">

        <Label Text="Create Account" 
               FontSize="32" 
               HorizontalOptions="Center" 
               FontAttributes="Bold" 
               TextColor="White"
               Margin="0,0,0,10"/>

        <Border Stroke="#B0B0B0" StrokeThickness="1.5" StrokeShape="RoundRectangle 10" BackgroundColor="Transparent" Padding="15, 0">
            <Entry Placeholder="First Name" Text="{Binding FirstName}" TextColor="White" PlaceholderColor="#B0B0B0" BackgroundColor="Transparent" />
        </Border>

        <Border Stroke="#B0B0B0" StrokeThickness="1.5" StrokeShape="RoundRectangle 10" BackgroundColor="Transparent" Padding="15, 0">
            <Entry Placeholder="Last Name" Text="{Binding LastName}" TextColor="White" PlaceholderColor="#B0B0B0" BackgroundColor="Transparent" />
        </Border>

        <Border Stroke="#B0B0B0" StrokeThickness="1.5" StrokeShape="RoundRectangle 10" BackgroundColor="Transparent" Padding="15, 0">
            <Entry Placeholder="Email" Text="{Binding UserName}" Keyboard="Email" TextColor="White" PlaceholderColor="#B0B0B0" BackgroundColor="Transparent">
                <Entry.Behaviors>
                    <toolkit:EmailValidationBehavior 
                        Flags="ValidateOnValueChanged"
                        IsValid="{Binding IsEmailValid}" />
                </Entry.Behaviors>
            </Entry>
        </Border>

        <Border Stroke="#B0B0B0" StrokeThickness="1.5" StrokeShape="RoundRectangle 10" BackgroundColor="Transparent" Padding="15, 0">
            <Grid ColumnDefinitions="*, Auto">
                <Entry Grid.Column="0" Placeholder="Password" Text="{Binding UserPassword}" TextColor="White" PlaceholderColor="#B0B0B0" BackgroundColor="Transparent" IsPassword="{Binding EntryAsPassword}" />
                <Button Grid.Column="1" Text="{Binding PasswordIconCode}" Command="{Binding TogglePasswordCommand}" BackgroundColor="Transparent" TextColor="White" FontSize="24" Padding="0" FontFamily="MaterialIcons" />
            </Grid>
        </Border>

        <Border Stroke="#B0B0B0" StrokeThickness="1.5" StrokeShape="RoundRectangle 10" BackgroundColor="Transparent" Padding="15, 0">
            <Entry Placeholder="Phone number" Text="{Binding Phone}" Keyboard="Telephone" TextColor="White" PlaceholderColor="#B0B0B0" BackgroundColor="Transparent" />
        </Border>

        <Button Text="Sign Up" Command="{Binding SignUpCommand}" TextColor="White" CornerRadius="25" HeightRequest="50" FontAttributes="Bold" FontSize="18" Margin="0, 15, 0, 0">
            <Button.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="BackgroundColor" Value="#555555" />
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
                <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                    <Setter Property="BackgroundColor" Value="#8A2BE2" />
                    <Setter Property="Opacity" Value="1.0" />
                </Trigger>
            </Button.Triggers>
        </Button>

        <Label Text="{Binding SignUpMessage}" TextColor="{Binding SignUpMessageColor}" IsVisible="{Binding SignUpMessageVisible}" HorizontalOptions="Center" FontSize="16" FontAttributes="Bold" />

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,10,0,0">
            <Label Text="Already have an account?" TextColor="#B0B0B0" VerticalOptions="Center"/>
            <Label Text="Sign in" TextColor="#8A2BE2" FontAttributes="Bold" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToSignInCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>